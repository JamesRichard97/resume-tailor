# =============================================================================
# Resume Tailor — frontend environment (production)
#
# Copy to `.env.production`. Vite reads these at BUILD time and bakes them into
# the bundle, so you must rebuild after changing anything here — editing it on
# a running server does nothing.
#
# Nothing secret belongs in this file. Every VITE_* value ships to the browser
# in plain text. API keys stay in the backend's .env.
# =============================================================================


# -----------------------------------------------------------------------------
# Where the browser sends /api calls
# -----------------------------------------------------------------------------
# SAME-ORIGIN (recommended): nginx serves the built files and proxies /api to
# uvicorn. Leave this commented out — the default "/api" is a relative path, so
# it works on any hostname, needs no CORS, and keeps cookies first-party.
#
#     location /api/ { proxy_pass http://127.0.0.1:8000; }
#
# VITE_API_BASE_URL=/api

# SEPARATE HOSTS: frontend on Vercel/Netlify/S3, backend elsewhere. Set the
# full origin including /api, no trailing slash. The backend's CORS_ORIGINS
# must then list this site's origin, or the browser blocks every request.
#
# VITE_API_BASE_URL=https://api.resume.example.com/api


# -----------------------------------------------------------------------------
# Dev-only
# -----------------------------------------------------------------------------
# Where `npm run dev` proxies /api. Irrelevant to a production build.
# VITE_API_TARGET=http://127.0.0.1:8000


# =============================================================================
# Build and serve
# =============================================================================
#   npm ci && npm run build      ->  dist/
#
# Serve dist/ as static files. It is a single-page app, so unknown paths must
# fall back to index.html or a refresh on /register returns 404:
#
#   location / { try_files $uri $uri/ /index.html; }
#
# The .docx download reads the Content-Disposition header for its filename.
# Same-origin deploys are fine. Cross-origin needs the backend to expose it —
# it already sends Access-Control-Expose-Headers: Content-Disposition, so just
# make sure your proxy does not strip that header.
