# =============================================================================
# Resume Tailor — backend environment (production)
#
# Copy to `.env` on the server, fill in the marked values, then:
#     chmod 600 .env          # it holds API keys
#
# `.env` is already in .gitignore. Keep it that way — committing it leaks your
# keys into every clone and every CI log.
#
# Every value below is read at startup only. Restart uvicorn after editing.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Storage
# -----------------------------------------------------------------------------
# One SQLite file holds everything: users and the sections they registered,
# generated resumes, and the application registry. Back this up and you have
# backed up the lot.
#
# Absolute path. The relative default (data/resume-tailor.db) resolves against
# the working directory, which is not what you want under systemd or Docker —
# a stray `cd` silently gives you an empty database.
#
# In a container this MUST be on a mounted volume, or every deploy wipes it.
DATABASE_FILE=/var/lib/resume-tailor/resume-tailor.db

# Only needed when upgrading from the JSON-file version. At startup the app
# imports db.json and any YYYYMMDD_registry.json it finds, then renames them to
# *.imported. Point these at wherever those files are; once the import has run
# they do nothing and can be removed from this file.
# DATA_FILE=/var/lib/resume-tailor/db.json
# REGISTRY_DIR=/var/lib/resume-tailor


# -----------------------------------------------------------------------------
# 2. CORS — who may call this API from a browser
# -----------------------------------------------------------------------------
# Comma-separated, scheme included, NO trailing slash. Localhost defaults are
# useless in production and a wildcard would let any site on the internet drive
# your API with your keys.
#
#   Same-origin deploy (nginx serves the SPA and proxies /api to this app):
#       CORS_ORIGINS=https://resume.example.com
#   Frontend on a different host (Vercel, Netlify, S3):
#       CORS_ORIGINS=https://resume-tailor.vercel.app
#   Preview deployments too:
#       CORS_ORIGINS=https://resume.example.com,https://staging.example.com
CORS_ORIGINS=https://resume.example.com


# -----------------------------------------------------------------------------
# 3. Generation model — writes the tailored resume
# -----------------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions server. Include the port and the API
# prefix. Leave LLM_BASE_URL empty and the app reports "not configured" cleanly
# rather than failing at generation time.
#
#   OpenAI          https://api.openai.com/v1      (needs LLM_API_KEY)
#   Azure OpenAI    https://<res>.openai.azure.com/openai/deployments/<dep>
#   Together        https://api.together.xyz/v1
#   Self-hosted     http://127.0.0.1:8001/v1       (vLLM on the same box)
#
# If the model runs on the SAME server, use 127.0.0.1 — not the public
# hostname. It avoids a pointless round trip out and back through your
# firewall, and keeps the model port closed to the internet.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-REPLACE-ME

# Seconds to wait for a completion. Must be LOWER than your reverse proxy's
# read timeout, or nginx returns its own 504 and the app's clearer message
# never reaches the browser. nginx defaults to 60s — either raise
# proxy_read_timeout to 180s, or drop this to 50.
LLM_TIMEOUT=120

# Low: the resume must stay faithful to the stored profile.
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# auto = send response_format=json_object, retry without it if rejected.
# on   = always send it (OpenAI, Azure, LM Studio, recent Ollama).
# off  = never send it; rely on the prompt alone.
LLM_JSON_MODE=auto


# -----------------------------------------------------------------------------
# 4. Claude — the "Humanize" pass
# -----------------------------------------------------------------------------
# Anthropic's Messages API. Separate from the block above on purpose: the two
# passes can use different providers, and leaving this unset simply disables
# the Humanize button's backend (the UI says so) without affecting generation.
#
# CLAUDE_MODEL has no default. Model ids change over time, and silently calling
# a wrong or deprecated one is worse than being told to set it. Copy the
# current id from your Anthropic console.
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=REPLACE-ME
CLAUDE_API_KEY=sk-ant-REPLACE-ME

# Higher than the generation pass. Rewriting for natural rhythm needs some
# freedom, and the facts are protected by code (app/humanize.py), not by a low
# temperature — the merge copies every factual field from the original.
CLAUDE_TEMPERATURE=0.8
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT=120

# Anthropic API version header. Pinned deliberately; do not track "latest".
CLAUDE_VERSION=2023-06-01


# =============================================================================
# Before you go live — things this file cannot fix
# =============================================================================
#
# 1. MULTIPLE WORKERS ARE NOW FINE. The old JSON store was guarded by an
#    in-process lock that separate processes could not share, so more than one
#    worker lost writes. SQLite arbitrates between processes itself, and the
#    app runs in WAL mode with a busy timeout, so `uvicorn --workers 4` is safe.
#    Keep them on the same machine: SQLite over a network filesystem is not.
#
# 2. BACK UP DATABASE_FILE. It holds every registered profile, every generated
#    resume and the whole application registry. Use SQLite's own backup so you
#    never copy a half-written file:
#        sqlite3 /var/lib/resume-tailor/resume-tailor.db ".backup /backups/rt.db"
#    A plain `cp` of a live database can capture a torn write; `.backup` cannot.
#    Note the -wal and -shm files beside it — `.backup` folds them in for you.
#
# 3. THERE IS NO AUTHENTICATION. Anyone who can reach the API can list every
#    registered person, read their contact details, and spend your API credits.
#    Put it behind SSO, a VPN, or at minimum HTTP basic auth at the proxy.
#
# 4. NO RATE LIMITING. Each generation costs real money. Limit
#    POST /api/tailor and /humanize at the proxy.
#
# 5. THE PROFILE LEAVES YOUR SERVER. Each request sends the person's name,
#    email, phone, LinkedIn and full work history to whichever endpoint you
#    configured above. If that is not acceptable for the people you register,
#    point LLM_BASE_URL at a model you host.
#
# 6. TERMINATE TLS at the proxy. This app speaks plain HTTP; put nginx,
#    Caddy or a load balancer in front with a real certificate.
