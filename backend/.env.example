# Path to the JSON database file (default: backend/data/db.json)
DATA_FILE=data/db.json

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Model used to generate tailored resumes.
#
# Any OpenAI-compatible /chat/completions server works. Include the port and
# the API prefix. Leave LLM_BASE_URL empty (or delete it) and the app will say
# so clearly instead of failing at generation time.
#
#   OpenAI      https://api.openai.com/v1        + LLM_API_KEY=sk-...
#   LM Studio   http://localhost:1234/v1
#   Ollama      http://localhost:11434/v1
#   vLLM        http://localhost:8001/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_API_KEY=

# Seconds to wait for a completion. Local models on CPU can be slow.
LLM_TIMEOUT=120

# Lower is more faithful to the profile; higher is more inventive.
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# The model is asked for structured JSON so the .docx can be built from it.
#   auto  send response_format=json_object, retry without it if rejected
#   on    always send it (OpenAI, LM Studio, recent Ollama)
#   off   never send it — rely on the prompt alone
LLM_JSON_MODE=auto

# ---------------------------------------------------------------------------
# Claude — used by the "Humanize" pass, which rewrites the generated resume so
# it reads like a person wrote it. This speaks Anthropic's Messages API, not
# the OpenAI one, so it is configured separately and can point somewhere else
# entirely from LLM_BASE_URL above.
#
# CLAUDE_MODEL has no default on purpose: model ids change, and silently
# calling the wrong one is worse than being told to set it. Check the current
# ids in your Anthropic console.
# ---------------------------------------------------------------------------
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=
CLAUDE_API_KEY=

# Higher than the generation pass: rewriting for natural rhythm needs some
# freedom, and the facts are protected by code rather than by low temperature.
CLAUDE_TEMPERATURE=0.8
CLAUDE_MAX_TOKENS=4000
CLAUDE_TIMEOUT=120
CLAUDE_VERSION=2023-06-01
