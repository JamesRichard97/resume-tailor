# Path to the JSON database file (default: backend/data/db.json)
DATA_FILE=data/db.json

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Model used to generate tailored resumes.
#
# Any OpenAI-compatible /chat/completions server works. Include the port and
# the API prefix. Leave LLM_BASE_URL empty (or delete it) and the app will say
# so clearly instead of failing at generation time.
#
#   OpenAI      https://api.openai.com/v1        + LLM_API_KEY=sk-...
#   LM Studio   http://localhost:1234/v1
#   Ollama      http://localhost:11434/v1
#   vLLM        http://localhost:8001/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_MODEL=gpt-4o
LLM_API_KEY=

# Seconds to wait for a completion — the whole generation, not one call.
# Output is written serially at roughly 30-80 tokens a second, so a detailed
# resume can legitimately take most of a minute; local models on CPU are
# slower still. The browser gives up a few seconds after this, so a long value
# here means a long wait with nothing on screen — but too short a one kills
# generations that were still making progress.
LLM_TIMEOUT=60

# Lower is more faithful to the profile; higher is more inventive.
LLM_TEMPERATURE=0.3
# Ceiling for one generated resume. A detailed one — a bullet per point,
# technologies named in each — runs past 2000; a cut-off answer arrives
# as invalid JSON. 8000 leaves room for the unlimited-length details the
# profile form now accepts.
LLM_MAX_TOKENS=8000

# Two follow-up calls that repair what the first answer missed: one writing
# sample sentences for posting terms no sentence used, one adding resume
# lines for profile terms the resume left out. They are the difference
# between "3 terms still uncovered" in the side panels and none — and they
# roughly TRIPLE the wait, because each is a whole round trip and output is
# what generation time is spent on.
#   off  one call per generation; the panels report what was missed (default)
#   on   up to three calls; the gaps are closed instead of reported
LLM_REFINE=off

# The model is asked for structured JSON so the .docx can be built from it.
#   auto  send response_format=json_object, retry without it if rejected
#   on    always send it (OpenAI, LM Studio, recent Ollama)
#   off   never send it — rely on the prompt alone
LLM_JSON_MODE=auto

# ---------------------------------------------------------------------------
# Claude — used by the "Humanize" pass, which rewrites the generated resume so
# it reads like a person wrote it. This speaks Anthropic's Messages API, not
# the OpenAI one, so it is configured separately and can point somewhere else
# entirely from LLM_BASE_URL above.
#
# CLAUDE_MODEL has no default on purpose: model ids change, and silently
# calling the wrong one is worse than being told to set it. Check the current
# ids in your Anthropic console.
# ---------------------------------------------------------------------------
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=
CLAUDE_API_KEY=

# Higher than the generation pass: rewriting for natural rhythm needs some
# freedom, and the facts are protected by code rather than by low temperature.
CLAUDE_TEMPERATURE=0.8
# Keep this equal to LLM_MAX_TOKENS above. The humanize pass returns the whole
# resume rewritten, so its answer is as long as the generated one — a smaller
# ceiling here truncates the rewrite and loses a resume that generated fine.
CLAUDE_MAX_TOKENS=8000
CLAUDE_TIMEOUT=60
CLAUDE_VERSION=2023-06-01
